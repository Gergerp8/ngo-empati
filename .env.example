# ─── NGO Empati — Environment Variables ───────────────────────────────
# Copy to `.env.local` and fill in. The site runs without these in demo
# mode (forms show success states); with them, everything persists live.

# Supabase (Database + Auth) — Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# After filling the above:
#   1. Run supabase/migrations/0001_init.sql in the Supabase SQL Editor
#   2. node scripts/create-admin.mjs admin@ngoempati.org <kata-laluan-kukuh>
#   3. npm run dev → /log-masuk → /admin

# Payments (recurring donation) — see app/api/donation/route.ts
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Email (notifications / verification)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://ngoempati.org
